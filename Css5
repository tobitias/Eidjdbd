/* =========================
   VARIABLES
========================= */

:root {

    --verde: #16a34a;
    --verde-oscuro: #166534;
    --amarillo: #facc15;

    --fondo: #f5f7f5;
    --blanco: #ffffff;

    --negro: #172117;
    --gris: #647064;

    --borde: #d9e0d9;

    --fuente-titulo: "Poppins", sans-serif;
    --fuente-texto: "Inter", sans-serif;

    --espacio-1: 8px;
    --espacio-2: 16px;
    --espacio-3: 24px;
    --espacio-4: 32px;
    --espacio-5: 48px;

}


/* =========================
   GENERAL
========================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--fondo);
    color: var(--negro);
    font-family: var(--fuente-texto);
    line-height: 1.6;
}

h1,
h2,
h3 {
    font-family: var(--fuente-titulo);
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
select,
textarea {
    font-family: var(--fuente-texto);
}

.contenedor {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}


/* =========================
   BOTONES
========================= */

.btn {
    display: inline-block;

    border: none;
    border-radius: 8px;

    padding: 12px 20px;

    font-size: 14px;
    font-weight: 700;

    cursor: pointer;

    transition: 0.2s;
}

.btn-principal {
    background: var(--verde);
    color: white;
}

.btn-principal:hover {
    background: var(--verde-oscuro);
    transform: translateY(-2px);
}

.btn-login {
    background: var(--negro);
    color: white;
}

.btn-login:hover {
    opacity: 0.8;
}


/* =========================
   NAVBAR
========================= */

.navbar {
    background: var(--blanco);
    border-bottom: 1px solid var(--borde);
}

.navbar-contenido {
    height: 70px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    color: var(--verde);
}

nav {
    display: flex;
    gap: 30px;
}

nav a {
    font-size: 14px;
    font-weight: 500;
}

nav a:hover {
    color: var(--verde);
}


/* =========================
   INICIO
========================= */

.inicio {
    background: var(--negro);
    color: white;

    padding: 70px 0;
}

.inicio-contenido {
    display: grid;

    grid-template-columns: 1.5fr 1fr;

    gap: 50px;

    align-items: center;
}

.etiqueta {
    color: var(--amarillo);

    font-size: 14px;
    font-weight: 700;

    letter-spacing: 1px;
}

.inicio h1 {
    font-size: 46px;

    margin: 15px 0;
}

.inicio h1 span {
    display: block;
    color: var(--verde);
}

.descripcion {
    max-width: 550px;

    color: #d1d5db;

    margin-bottom: 25px;
}

.inicio-info {
    background: white;
    color: var(--negro);

    padding: 35px;

    border-radius: 15px;
}

.pelota {
    font-size: 50px;

    margin-bottom: 15px;
}

.inicio-info p {
    color: var(--gris);

    margin-top: 10px;
}


/* =========================
   BUSCADOR
========================= */

.buscador {
    margin-top: -30px;

    position: relative;
}

.buscador-contenido {
    background: white;

    padding: 24px;

    border-radius: 12px;

    display: grid;

    grid-template-columns:
        1fr 1fr 1fr auto;

    gap: 15px;

    box-shadow:
        0 5px 20px rgba(0, 0, 0, 0.1);
}

.buscador label {
    display: block;

    font-size: 14px;
    font-weight: 700;

    margin-bottom: 5px;
}

.buscador input,
.buscador select {
    width: 100%;

    padding: 11px;

    border: 1px solid var(--borde);

    border-radius: 7px;

    background: white;

    outline: none;
}

.buscador input:focus,
.buscador select:focus {
    border-color: var(--verde);
}


/* =========================
   CANCHAS
========================= */

.canchas {
    padding: 70px 0;
}

.titulo-seccion {
    display: flex;

    justify-content: space-between;
    align-items: end;

    margin-bottom: 30px;
}

.titulo-seccion h2 {
    margin-top: 5px;
}

.titulo-seccion a {
    color: var(--verde);

    font-weight: 700;
}

.tarjetas {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 25px;
}


/* TARJETAS */

.tarjeta {
    background: white;

    border: 1px solid var(--borde);

    border-radius: 14px;

    overflow: hidden;

    transition: 0.2s;
}

.tarjeta:hover {
    transform: translateY(-4px);

    box-shadow:
        0 8px 20px rgba(0, 0, 0, 0.1);
}

.imagen-cancha {
    height: 190px;

    position: relative;

    background-size: cover;
    background-position: center;
}

.cancha-1 {
    background-image:
        url("https://images.unsplash.com/photo-1553778263-73a83bab9b0c?auto=format&fit=crop&w=800&q=80");
}

.cancha-2 {
    background-image:
        url("https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=800&q=80");
}

.cancha-3 {
    background-image:
        url("https://images.unsplash.com/photo-1526232761682-d26e03ac148e?auto=format&fit=crop&w=800&q=80");
}

.imagen-cancha span {
    position: absolute;

    top: 15px;
    left: 15px;

    background: white;

    color: var(--verde-oscuro);

    padding: 6px 10px;

    border-radius: 6px;

    font-size: 13px;
    font-weight: 700;
}

.tarjeta-contenido {
    padding: 20px;
}

.titulo-tarjeta {
    display: flex;

    justify-content: space-between;
    align-items: start;

    gap: 10px;
}

.titulo-tarjeta h3 {
    margin-bottom: 5px;
}

.titulo-tarjeta p {
    color: var(--gris);

    font-size: 14px;
}

.titulo-tarjeta strong {
    background: #dcfce7;

    color: var(--verde-oscuro);

    padding: 5px 8px;

    border-radius: 5px;

    font-size: 12px;
}

.caracteristicas {
    display: flex;

    gap: 12px;

    margin: 20px 0;

    color: var(--gris);

    font-size: 13px;
}

.pie-tarjeta {
    border-top: 1px solid var(--borde);

    padding-top: 15px;

    display: flex;

    justify-content: space-between;
    align-items: center;
}

.pie-tarjeta b {
    font-size: 18px;
}


/* =========================
   CONTACTO
========================= */

.contacto {
    background: white;

    padding: 70px 0;
}

.contacto-contenido {
    display: grid;

    grid-template-columns:
        1fr 1.2fr;

    gap: 50px;

    align-items: start;
}

.contacto-info h2 {
    font-size: 32px;

    margin: 10px 0 15px;
}

.contacto-info > p:not(.etiqueta) {
    color: var(--gris);

    max-width: 450px;
}

.datos-contacto {
    margin-top: 30px;

    display: flex;

    flex-direction: column;

    gap: 15px;
}

.datos-contacto p {
    font-weight: 500;
}


/* FORMULARIO */

.formulario-contacto {
    background: var(--fondo);

    padding: 30px;

    border: 1px solid var(--borde);

    border-radius: 14px;
}

.fila-formulario {
    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 15px;
}

.campo {
    display: flex;

    flex-direction: column;

    gap: 7px;

    margin-bottom: 18px;
}

.campo label {
    font-size: 14px;

    font-weight: 700;
}

.campo input,
.campo select,
.campo textarea {
    width: 100%;

    padding: 12px;

    border: 1px solid var(--borde);

    border-radius: 8px;

    background: white;

    font-size: 14px;

    outline: none;
}

.campo textarea {
    resize: vertical;

    min-height: 120px;
}

.campo input:focus,
.campo select:focus,
.campo textarea:focus {
    border-color: var(--verde);
}

.formulario-contacto .btn {
    width: 100%;
}


/* =========================
   FOOTER
========================= */

footer {
    background: var(--negro);

    color: white;

    padding: 30px 0;
}

footer h3 {
    color: var(--verde);
}

footer p {
    color: #9ca3af;

    margin-top: 5px;
}


/* =========================
   CELULAR
========================= */

@media (max-width: 800px) {

    .inicio-contenido {
        grid-template-columns: 1fr;
    }

    .tarjetas {
        grid-template-columns: 1fr;
    }

    .buscador-contenido {
        grid-template-columns: 1fr;
    }

    .contacto-contenido {
        grid-template-columns: 1fr;
    }

    .fila-formulario {
        grid-template-columns: 1fr;
    }

    nav {
        display: none;
    }

    .inicio h1 {
        font-size: 36px;
    }

}
